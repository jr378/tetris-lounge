# ─── Email (contact form) ───────────────────────────────────────
# Resend API key — required for the /api/contact route to actually send mail.
# If unset, the form falls back to a mailto: link in the user's email client.
# Get one at https://resend.com.
RESEND_API_KEY=

# Sender address used by Resend. Must be from a domain you've verified
# in your Resend dashboard. Falls back to Resend's onboarding sandbox
# (deliverable only to the account owner) if unset.
# Format: "Display Name <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=

# Inbox that receives form submissions. Defaults to jackreed16@gmail.com
# if unset. Override here for staging or to fan-out to a shared inbox.
CONTACT_TO_EMAIL=
